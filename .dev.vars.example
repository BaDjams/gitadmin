# Copier ce fichier en `.dev.vars` pour le développement local.
# En production, définir ces valeurs avec `wrangler secret put <NOM>`.

# Clés Turnstile de TEST fournies par Cloudflare (toujours valides en local).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Destinataires des demandes (adresses vérifiées dans Email Routing), séparés par des virgules.
DEMANDE_DESTINATAIRES=exemple@example.com

# En local, les photos R2 sont servies par le Worker lui-même.
IMG_BASE_URL=/media
SITE_URL=http://localhost:4321
